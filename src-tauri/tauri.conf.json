{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowWorker",
  "mainBinaryName": "ShowWorker",
  "version": "0.1.1",
  "identifier": "com.xingpengcheng.showworker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShowWorker",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' md-asset: data: blob:; style-src 'self' 'unsafe-inline'; img-src 'self' md-asset: data: blob: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "template": "./nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NDczMkQ3RkRCQjc3NkQKUldSdGQ3djkxekpIOWk4TGovc29KTFdDbi9ZMjZyRjhSSHJrWktMRkk4bVFiUlRmM0QvZDl4OWoK",
      "endpoints": [
        "https://github.com/xingpengcheng417/show-worker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
