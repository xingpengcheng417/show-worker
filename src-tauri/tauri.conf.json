{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFlow",
  "version": "0.1.0",
  "identifier": "com.xingpengcheng.markflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkFlow",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' md-asset: data: blob:; style-src 'self' 'unsafe-inline'; img-src 'self' md-asset: data: blob: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
